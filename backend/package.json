{
  "name": "genovault-backend",
  "version": "1.0.0",
  "description": "GenoVault Backend API - Secure genomic data management platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "jest tests/ --verbose",
    "test:json": "jest tests/ --json --outputFile=../results/jest_results.json",
    "test:coverage": "jest tests/ --coverage",
    "experiment:blockchain": "node experiments/blockchainBenchmark.js",
    "experiment:blockchain:local": "node experiments/blockchainBenchmarkLocal.js",
    "experiment:blockchain:complete": "node experiments/blockchainCompleteTest.js",
    "experiment:download": "node experiments/downloadBenchmark.js",
    "experiment:azureipfs": "node experiments/azureIpfsComparison.js",
    "experiment:azureipfs:local": "node experiments/azureIpfsComparisonLocal.js",
    "experiment:robustness": "node experiments/watermarkRobustnessHarness.js",
    "experiment:robustness:diagnostic": "node experiments/robustnessDiagnostic.js",
    "experiment:fastq": "node experiments/fastqDownstreamImpact.js",
    "experiment:sra:local": "node experiments/sraLocalIntegrationTest.js",
    "report": "node experiments/generateTestReport.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 30000,
    "verbose": true
  },
  "keywords": [
    "genomics",
    "vault",
    "api",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/storage-blob": "^12.31.0",
    "@otplib/preset-default": "^12.0.1",
    "axios": "^1.16.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.5.0",
    "ethers": "^6.16.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "form-data": "^4.0.5",
    "googleapis": "^171.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.14.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.7",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
